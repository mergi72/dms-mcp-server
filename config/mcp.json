{
  "bridge": {
    "url": "http://127.0.0.1:8765",
    "minimumVersion": "0.2.0"
  },
  "server": {
    "host": "127.0.0.1",
    "port": 8781,
    "path": "/mcp",
    "statelessHttp": true
  },
  "inspector": {
    "host": "127.0.0.1",
    "port": 8780
  },
  "runtime": {
    "timeoutSeconds": 30,
    "maxDocumentBytes": 1048576
  },
  "search": {
    "mode": "recursive_list",
    "caseSensitive": false,
    "maxDepth": 64,
    "maxFolders": 5000,
    "timeoutSeconds": 120,
    "concurrency": 4,
    "maxResults": 1000
  },
  "routing": {
    "connections": {
      "edocat": {
        "lowLevelConnection": "alfresco",
        "operations": [
          "list_items",
          "search_items",
          "read_document"
        ]
      }
    }
  },
  "debug": {
    "enable": true,
    "path": "%APPDATA%\\DMS MCP\\logs",
    "loggerLevels": {
      "httpx": "WARNING",
      "httpcore": "WARNING"
    }
  }
}
